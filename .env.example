# NEXT_PUBLIC_SITE_URL: canonical origin, no trailing slash. Drives the
# canonical link, sitemap, robots.txt and structured data. Set this per
# environment — a preview deploy that claims the production URL tells search
# engines two hosts serve the same page.
NEXT_PUBLIC_SITE_URL="https://www.awanishverma.com"

# Search engine ownership verification. Google Search Console issues the first;
# Bing Webmaster Tools issues the second, which also covers Yahoo and
# DuckDuckGo. Both are optional — leave unset and no meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
